{
  "version": 2,
  "buildCommand": "node build.js",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "functions": {
    "api/send-email.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/ingest-civitatis.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/ingest-civitatis-write.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/cron-ingest-civitatis-write.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/agency-research.js": {
      "maxDuration": 300,
      "memory": 512
    },
    "api/agency-draft-outreach.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/agency-send-email.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/agency-mailbox-sync.js": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
